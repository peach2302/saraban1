# ============================================
# E-Saraban Backend Configuration
# ============================================

# Google Sheets Configuration
# ============================
# Spreadsheet ID จาก URL ของ Google Sheets
# ตัวอย่าง: https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms/edit
# ให้ใส่เฉพาะ ID: 1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
GOOGLE_SPREADSHEET_ID=

# Service Account Credentials
# ============================
# วิธีรับ:
# 1. ไปที่ Google Cloud Console
# 2. สร้าง Service Account
# 3. สร้าง Key แบบ JSON
# 4. Copy email และ private_key มาใส่ที่นี่

# Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key (จาก JSON key file)
# หมายเหตุ: เปลี่ยน \n จริงใน key เป็น \\n
# หรือใช้ GOOGLE_SERVICE_ACCOUNT_KEY_FILE แทน
GOOGLE_PRIVATE_KEY=

# หรือระบุ path ไปยัง JSON key file (ใช้แทน GOOGLE_PRIVATE_KEY)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
