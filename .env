# ============================================
# E-Saraban Environment Configuration
# ระบบสารบรรณอิเล็กทรอนิกส์ — เทศบาลตำบลป่งไฮ
# ============================================

# Google Sheets Configuration
# ============================
# Spreadsheet ID — ทราบแล้วจาก URL
GOOGLE_SPREADSHEET_ID=1JDfRSCQJy7bsNgONUztTaNc-ucNuKkJadOSUah7Gpes

# Service Account Email (จาก Google Cloud Console)
# ⚠️ ต้องตั้งค่า — ดูคำแนะนำใน PHASE-1B-REPORT-TH.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key (จาก Service Account JSON)
# ⚠️ ต้องตั้งค่า — ดูคำแนะนำใน PHASE-1B-REPORT-TH.md
# หมายเหตุ: ต้องใส่ newline เป็น \n
GOOGLE_PRIVATE_KEY=

# หรือใช้ JSON key file แทน (เลือกอย่างใดอย่างหนึ่ง)
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./service-account-key.json

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# ============================================
# Security
# ============================================
# JWT Secret (สำหรับ Authentication ใน Phase ถัดไป)
JWT_SECRET=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
