# ============================================
# E-Saraban Environment Configuration
# ระบบสารบรรณอิเล็กทรอนิกส์ — เทศบาลตำบลป่งไฮ
# ============================================

# Google Sheets Configuration
# ============================
# Spreadsheet ID จาก URL ของ Google Sheets
# ตัวอย่าง: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SPREADSHEET_ID=

# Service Account Email (จาก Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private Key (จาก Service Account JSON)
# หมายเหตุ: ต้องใส่ newline เป็น \n
GOOGLE_PRIVATE_KEY=

# ============================================
# Server Configuration
# ============================================
PORT=4000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# ============================================
# Security
# ============================================
# JWT Secret (สำหรับ Authentication ใน Phase ถัดไป)
JWT_SECRET=

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
